@page
@model Tracking_Tool_System.Pages.Transaction.CreateTransactionModel

@{
    ViewData["Title"] = "Crear tipo de transaccion"; 
}

        <section class="content-header">
            <div class="container-fluid">
                <h1>Crear Transaccion</h1>
            </div>
        </section>

        <section class="content">
            <div class="container-fluid">

                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title">Información de la transaccion</h3>
                    </div>

                    <form method="post">
                        <div class="card-body">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <div class="form-group">
                                <label>Transaccion</label>
                                <input asp-for="TransactionType" class="form-control" placeholder="Ingrese la transaccion"/>
                            </div>                       

                            <div class="form-group">
                                <label>Estado</label>
                                <select asp-for="TransactionStatus" class="form-control">
                                    <option value="Activa">Activa</option>
                                    <option value="Inactiva">Inactiva</option>
                                </select>
                            </div>

                        </div>

                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">Guardar</button>
                            <a asp-page="/Transaction/Transaction_List" class="btn btn-secondary">
                                <i class="fas fa-arrow-left mr-1"></i>
                                Regresar
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </section>
