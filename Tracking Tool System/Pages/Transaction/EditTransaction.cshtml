@page
@model Tracking_Tool_System.Pages.Transaction.EditTransactionModel

@{
    ViewData["Title"] = "Editar tipo de transaccion";
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Modificar Transaccion</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Modificar</h3>
            </div>

            <form method="post">
                <div class="card-body">

                    <input type="hidden" asp-for="TransactionTypeID" />

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>Transaccion</label>
                        <input asp-for="TransactionType"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <select asp-for="TransactionStatus" class="form-control">
                            <option value="Activa">Activa</option>
                            <option value="Inactiva">Inactiva</option>
                        </select>
                    </div>

                    <br />
                </div>

                        <div class="card-footer">
                            <button type="submit" class="btn btn-warning">Actualizar</button>
                            <a asp-page="/Transaction/Transaction_List" class="btn btn-secondary">Cancelar</a>
                        </div>

            </form>
        </div>

    </div>

</section>

