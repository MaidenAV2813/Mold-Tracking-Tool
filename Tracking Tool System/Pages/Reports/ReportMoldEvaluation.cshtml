@page
@model Tracking_Tool_System.Pages.Reports.ReportMoldEvaluationModel

@{
    ViewData["Title"] = "Reporte de Evaluaciones de Moldes";
}

<div class="container-fluid">

    <!-- Filtros -->
    <div class="card card-primary no-print">

        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-clipboard-check mr-2"></i>
                Reporte de Evaluaciones de Moldes
            </h3>
        </div>

        <div class="card-body">

            <form method="get" id="reportForm">

                <input type="hidden"
                       name="RunReport"
                       value="true" />

                <input type="hidden"
                       asp-for="MoldID"
                       id="MoldID" />

                <div class="row">

                    <!-- Molde -->
                    <div class="col-md-4">

                        <div class="form-group position-relative">

                            <label for="MoldSearch">
                                Molde
                            </label>

                            <input type="text"
                                   id="MoldSearch"
                                   name="MoldNumber"
                                   value="@Model.MoldNumber"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Digite el número de molde" />

                            <small class="form-text text-muted">
                                Digite el número de molde y seleccione una opción.
                                Déjelo vacío para consultar todos.
                            </small>

                            <div id="moldSearchResults"
                                 class="list-group position-absolute w-100 shadow"
                                 style="
                                z-index: 2000;
                                display: none;
                                max-height: 250px;
                                overflow-y: auto;
                                ">
                            </div>

                        </div>

                    </div>

                    <!-- Fecha inicial -->
                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="StartDate">
                                Fecha inicial
                            </label>

                            <input asp-for="StartDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <!-- Fecha final -->
                    <div class="col-md-3">

                        <div class="form-group">

                            <label asp-for="EndDate">
                                Fecha final
                            </label>

                            <input asp-for="EndDate"
                                   type="date"
                                   class="form-control" />

                        </div>

                    </div>

                    <!-- Botones -->
                    <div class="col-md-4 d-flex align-items-end">

                        <div class="form-group d-flex flex-wrap">

                            <button type="submit"
                                    class="btn btn-primary mr-2 mb-1">

                                <i class="fas fa-search mr-1"></i>
                                Ejecutar reporte

                            </button>

                            <a asp-page="/Reports/ReportMoldEvaluation"
                               class="btn btn-secondary mr-2 mb-1">

                                <i class="fas fa-eraser mr-1"></i>
                                Limpiar

                            </a>

                            <a asp-page="/Index"
                               class="btn btn-danger mb-1">

                                <i class="fas fa-times mr-1"></i>
                                Cancelar

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <!-- Mensaje de error -->
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger no-print">

            <i class="fas fa-exclamation-triangle mr-2"></i>
            @Model.ErrorMessage

        </div>
    }

    <!-- Resultado -->
    @if (Model.ReportExecuted)
    {
        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    Resultado del reporte
                </h3>

                <div class="card-tools d-flex align-items-center no-print">

                    @if (Model.ReportList.Count > 0)
                    {
                        <a asp-page="/Reports/ReportMoldEvaluation"
                           asp-page-handler="Export"
                           asp-route-MoldID="@Model.MoldID"
                           asp-route-MoldNumber="@Model.MoldNumber"
                           asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                           asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                           class="btn btn-success btn-sm mr-3">

                            <i class="fas fa-file-excel mr-1"></i>
                            Exportar Excel

                        </a>
                    }

                    <span class="badge badge-primary">
                        @Model.ReportList.Count registro(s)
                    </span>

                </div>

            </div>

            <div class="card-body">

                <!-- Encabezado visible solamente al imprimir -->
                <div class="print-header">

                    <h2>
                        Reporte de Evaluaciones de Moldes
                    </h2>

                    <p>
                        <strong>Molde:</strong>

                        @(string.IsNullOrWhiteSpace(Model.MoldNumber)
                            ? "Todos"
                            : Model.MoldNumber)
                    </p>

                    <p>
                        <strong>Fecha inicial:</strong>

                        @(Model.StartDate.HasValue
                            ? Model.StartDate.Value.ToString("MM-dd-yyyy")
                            : "Todas")
                    </p>

                    <p>
                        <strong>Fecha final:</strong>

                        @(Model.EndDate.HasValue
                            ? Model.EndDate.Value.ToString("MM-dd-yyyy")
                            : "Todas")
                    </p>

                    <p>
                        <strong>Fecha de impresión:</strong>
                        @DateTime.Now.ToString("MM-dd-yyyy HH:mm:ss")
                    </p>

                    <hr />

                </div>

                @if (Model.ReportList.Count == 0)
                {
                    <div class="alert alert-warning mb-0">

                        <i class="fas fa-info-circle mr-2"></i>

                        No se encontraron evaluaciones con los filtros
                        seleccionados.

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-bordered table-striped table-hover"
                               id="reportMoldEvaluationTable">

                            <thead class="thead-dark">

                                <tr>
@*                                     <th class="text-center">
                                        Evaluación
                                    </th> *@

                                    <th style="min-width:150px;">
                                        Número de molde
                                    </th>

                                    <th class="text-center">
                                        Fecha evaluación
                                    </th>

                                    <th class="text-center">
                                        Próxima evaluación
                                    </th>

                                    <th class="text-center">
                                        Score general
                                    </th>

                                    <th>
                                        Creado por
                                    </th>

                                    <th class="text-center">
                                        Fecha creación
                                    </th>

                                    <th class="text-center no-print">
                                        Acciones
                                    </th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in Model.ReportList)
                                {
                                    <tr>

@*                                         <td class="text-center">
                                            @item.EvaluationID
                                        </td> *@

                                        <td style="min-width:150px;">
                                            @item.MoldNumber
                                        </td>

                                        <td class="text-center">

                                            @(item.DateEvaluation.HasValue
                                                ? item.DateEvaluation.Value
                                                    .ToString("MM-dd-yyyy")
                                                : "")

                                        </td>

                                        <td class="text-center">

                                            @(item.NextEvaluationDate.HasValue
                                                ? item.NextEvaluationDate.Value
                                                    .ToString("MM-dd-yyyy")
                                                : "")

                                        </td>

                                        <!-- Score con los colores acordados -->
                                        <td class="text-center">

                                            @if (item.GeneralScore.HasValue)
                                            {
                                                if (item.GeneralScore >= 90)
                                                {
                                                    <span class="badge badge-success score-badge">

                                                        @($"{item.GeneralScore:N2}%")

                                                    </span>
                                                }
                                                else if (item.GeneralScore >= 70)
                                                {
                                                    <span class="badge badge-warning score-badge">

                                                        @($"{item.GeneralScore:N2}%")

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger score-badge">

                                                        @($"{item.GeneralScore:N2}%")

                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin score
                                                </span>
                                            }

                                        </td>

                                        <td>
                                            @item.CreatedBy
                                        </td>

                                        <td class="text-center">

                                            @(item.DateCreation.HasValue
                                                ? item.DateCreation.Value
                                                    .ToString("MM-dd-yyyy HH:mm:ss")
                                                : "")

                                        </td>

                                        <td class="text-center no-print">

                                            @if (item.EvaluationID.HasValue)
                                            {
                                                <a asp-page="/Reports/ReportMoldEvaluationDetail"
                                                   asp-route-EvaluationID="@item.EvaluationID"
                                                   class="btn btn-info btn-sm"
                                                   title="Ver detalle">

                                                    <i class="fas fa-eye"></i>
                                                    Ver detalle

                                                </a>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
    }

</div>

@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const moldSearch =
                document.getElementById("MoldSearch");

            const moldID =
                document.getElementById("MoldID");

            const resultsContainer =
                document.getElementById("moldSearchResults");

            const reportForm =
                document.getElementById("reportForm");

            let searchTimer = null;

            if (!moldSearch || !moldID || !resultsContainer) {

                console.error(
                    "No se encontraron los controles del buscador de moldes."
                );

                return;
            }

            /*
             * Buscar mientras se escribe.
             */
            moldSearch.addEventListener("input", function () {

                const term = moldSearch.value.trim();

                /*
                 * Cuando el usuario escribe nuevamente,
                 * se elimina el molde seleccionado anteriormente.
                 */
                moldID.value = "";

                clearTimeout(searchTimer);

                if (term.length < 1) {

                    hideResults();
                    return;
                }

                resultsContainer.innerHTML =
                    '<div class="list-group-item text-muted">'
                    + 'Buscando...'
                    + '</div>';

                resultsContainer.style.display = "block";

                searchTimer = setTimeout(function () {

                    searchMolds(term);

                }, 300);
            });

            async function searchMolds(term) {

                try {

                    const handlerUrl =
                        '@Url.Page(
                                                            "/Reports/ReportMoldEvaluation",
                                                            "SearchMolds"
                                            )';

                    const separator =
                        handlerUrl.includes("?") ? "&" : "?";

                    const url =
                        handlerUrl
                        + separator
                        + "term="
                        + encodeURIComponent(term);

                    const response = await fetch(url, {

                        method: "GET",

                        headers: {
                            "Accept": "application/json"
                        }
                    });

                    const responseText =
                        await response.text();

                    if (!response.ok) {

                        throw new Error(
                            responseText
                            || "Error al buscar los moldes."
                        );
                    }

                    const molds = responseText
                        ? JSON.parse(responseText)
                        : [];

                    resultsContainer.innerHTML = "";

                    if (!Array.isArray(molds)
                        || molds.length === 0) {

                        resultsContainer.innerHTML =
                            '<div class="list-group-item text-muted">'
                            + 'No se encontraron moldes.'
                            + '</div>';

                        resultsContainer.style.display = "block";

                        return;
                    }

                    molds.forEach(function (mold) {

                        const option =
                            document.createElement("button");

                        option.type = "button";

                        option.className =
                            "list-group-item "
                            + "list-group-item-action "
                            + "text-left";

                        const moldNumber =
                            mold.moldNumber || "";

                        const description =
                            mold.description || "";

                        option.innerHTML =
                            "<strong>"
                            + escapeHtml(moldNumber)
                            + "</strong>"
                            + (
                                description
                                    ? "<br>"
                                      + "<small class='text-muted'>"
                                      + escapeHtml(description)
                                      + "</small>"
                                    : ""
                            );

                        option.addEventListener(
                            "click",
                            function () {

                                moldID.value = mold.id;
                                moldSearch.value = moldNumber;

                                hideResults();
                            }
                        );

                        resultsContainer.appendChild(option);
                    });

                    resultsContainer.style.display = "block";
                }
                catch (error) {

                    console.error(
                        "Error buscando moldes:",
                        error
                    );

                    resultsContainer.innerHTML =
                        '<div class="list-group-item text-danger">'
                        + 'Error al consultar los moldes.'
                        + '</div>';

                    resultsContainer.style.display = "block";
                }
            }

            function hideResults() {

                resultsContainer.innerHTML = "";
                resultsContainer.style.display = "none";
            }

            function escapeHtml(value) {

                const div =
                    document.createElement("div");

                div.textContent = value || "";

                return div.innerHTML;
            }

            /*
             * Cierra la lista al hacer clic fuera del buscador.
             */
            document.addEventListener(
                "click",
                function (event) {

                    if (
                        !moldSearch.contains(event.target)
                        &&
                        !resultsContainer.contains(event.target)
                    ) {
                        hideResults();
                    }
                }
            );

            /*
             * Evita ejecutar el reporte para todos los moldes
             * cuando el usuario escribió un texto, pero no
             * seleccionó una opción de la lista.
             */
            if (reportForm) {

                reportForm.addEventListener(
                    "submit",
                    function (event) {

                        const typedText =
                            moldSearch.value.trim();

                        if (
                            typedText !== ""
                            && moldID.value === ""
                        ) {
                            event.preventDefault();

                            alert(
                                "Debe seleccionar el molde "
                                + "desde la lista de resultados."
                            );

                            moldSearch.focus();
                            return;
                        }

                        const startDate =
                            document.getElementById("StartDate");

                        const endDate =
                            document.getElementById("EndDate");

                        if (
                            startDate
                            && endDate
                            && startDate.value
                            && endDate.value
                            && startDate.value > endDate.value
                        ) {
                            event.preventDefault();

                            alert(
                                "La fecha inicial no puede ser "
                                + "mayor que la fecha final."
                            );

                            startDate.focus();
                        }
                    }
                );
            }
        });

    </script>
}

<style>

    .score-badge {
        min-width: 75px;
        padding: 7px 10px;
        font-size: 0.90rem;
    }

    .print-header {
        display: none;
    }

    @@media print {

        @@page {
            size: landscape;
            margin: 10mm;
        }

        .no-print,
        .main-header,
        .main-sidebar,
        .main-footer {
            display: none !important;
        }

        .content-wrapper {
            margin-left: 0 !important;
        }

        .container-fluid {
            width: 100%;
            padding: 0;
            margin: 0;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .card-header {
            display: none !important;
        }

        .card-body {
            padding: 0 !important;
        }

        .print-header {
            display: block;
            margin-bottom: 15px;
        }

            .print-header h2 {
                font-size: 20px;
                margin-bottom: 12px;
            }

            .print-header p {
                margin-bottom: 3px;
                font-size: 11px;
            }

        table {
            width: 100% !important;
            font-size: 9px;
        }

            table th,
            table td {
                padding: 4px !important;
            }

        .badge {
            border: 1px solid #000;
            color: #000 !important;
            background-color: transparent !important;
        }
    }

</style>