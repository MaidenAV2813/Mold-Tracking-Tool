@page
@model Tracking_Tool_System.Pages.Casting.CreateCastingModel
@{
	ViewData["Title"] = "Crear tipo de Colada";
}
<section class="content-header">
    <div class="container-fluid">
         <h1>Crear tipo de Colada</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Información de Coladas</h3>
            </div>

            <form method="post">
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>Tipo de Colada</label>
                        <input asp-for="CastingType" class="form-control" placeholder="Ingrese el tipo de colada" />
                    </div>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-page="/Casting/Casting_List" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>

    </div>
</section>