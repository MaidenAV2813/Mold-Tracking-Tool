@section Scripts
{
    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const maintenanceData =
                    @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            Model.Dashboard.MaintenanceByMonth
                        )
                    );

                const spareData =
                    @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                            Model.Dashboard.TopAssignedSpares
                        )
                    );

                const maintenanceLabels =
                    maintenanceData.map(function (item) {
                        return item.MonthName;
                    });

                const maintenanceValues =
                    maintenanceData.map(function (item) {
                        return item.MaintenanceCount;
                    });

                new Chart(
                    document.getElementById(
                        "maintenanceByMonthChart"
                    ).getContext("2d"),
                    {
                        type: "line",

                        data: {
                            labels: maintenanceLabels,

                            datasets: [
                                {
                                    label: "Mantenimientos realizados",
                                    data: maintenanceValues,
                                    fill: false,
                                    borderWidth: 3,
                                    pointRadius: 5,
                                    pointHoverRadius: 7,
                                    lineTension: 0.3
                                }
                            ]
                        },

                        options: {
                            responsive: true,
                            maintainAspectRatio: false,

                            legend: {
                                display: false
                            },

                            tooltips: {
                                callbacks: {
                                    label: function (tooltipItem) {
                                        return "Mantenimientos: " +
                                            tooltipItem.yLabel;
                                    }
                                }
                            },

                            scales: {
                                yAxes: [
                                    {
                                        ticks: {
                                            beginAtZero: true,
                                            precision: 0,
                                            stepSize: 1
                                        },

                                        scaleLabel: {
                                            display: true,
                                            labelString:
                                                "Cantidad de mantenimientos"
                                        }
                                    }
                                ],

                                xAxes: [
                                    {
                                        gridLines: {
                                            display: false
                                        }
                                    }
                                ]
                            }
                        }
                    }
                );

                const spareLabels =
                    spareData.map(function (item) {

                        const description =
                            item.ItemDescription || "";

                        if (description.length > 35) {
                            return description.substring(
                                0,
                                35
                            ) + "...";
                        }

                        return description ||
                            item.ItemNumber;
                    });

                const spareValues =
                    spareData.map(function (item) {
                        return item.TotalAssigned;
                    });

                new Chart(
                    document.getElementById(
                        "topAssignedSparesChart"
                    ).getContext("2d"),
                    {
                        type: "horizontalBar",

                        data: {
                            labels: spareLabels,

                            datasets: [
                                {
                                    label:
                                        "Cantidad asignada",

                                    data:
                                        spareValues,

                                    backgroundColor:
                                        "rgba(0, 123, 255, 0.75)",

                                    borderColor:
                                        "rgba(0, 123, 255, 1)",

                                    borderWidth: 1
                                }
                            ]
                        },

                        options: {
                            responsive: true,
                            maintainAspectRatio: false,

                            legend: {
                                display: true
                            },

                            scales: {
                                xAxes: [
                                    {
                                        ticks: {
                                            beginAtZero: true,
                                            precision: 0
                                        }
                                    }
                                ]
                            },

                            tooltips: {
                                callbacks: {
                                    title: function (
                                        tooltipItems,
                                        data
                                    ) {
                                        const index =
                                            tooltipItems[0]
                                                .index;

                                        const spare =
                                            spareData[index];

                                        return spare.ItemNumber;
                                    },

                                    label: function (
                                        tooltipItem
                                    ) {
                                        return (
                                            "Cantidad asignada: " +
                                            tooltipItem.xLabel
                                        );
                                    },

                                    afterLabel: function (
                                        tooltipItem
                                    ) {
                                        const spare =
                                            spareData[
                                                tooltipItem.index
                                            ];

                                        return spare
                                            .ItemDescription;
                                    }
                                }
                            }
                        }
                    }
                );

                const evaluationChart =
                new Chart(
                    document.getElementById("evaluationChart"),
                    {
                        type: "bar",

                        data:
                        {
                            labels:
                            [
                                "Verde",
                                "Amarillo",
                                "Rojo"
                            ],

                            datasets:
                            [
                                {
                                    label: "Cantidad de moldes",

                                    data:
                                    [
                                        @Model.Dashboard.GreenMolds,
                                        @Model.Dashboard.YellowMolds,
                                        @Model.Dashboard.RedMolds
                                    ],

                                    backgroundColor:
                                    [
                                        "#28a745",
                                        "#ffc107",
                                        "#dc3545"
                                    ],

                                    borderColor:
                                    [
                                        "#28a745",
                                        "#ffc107",
                                        "#dc3545"
                                    ],

                                    borderWidth:1
                                }
                            ]
                        },

                        options:
                        {
                            responsive:true,

                            maintainAspectRatio:false,

                            legend:
                            {
                                display:false
                            },

                            scales:
                            {
                                yAxes:
                                [
                                    {
                                        ticks:
                                        {
                                            beginAtZero:true,
                                            precision:0,
                                            stepSize:1
                                        }
                                    }
                                ]
                            }
                        }
                    });
            }
        );
    </script>
}
 