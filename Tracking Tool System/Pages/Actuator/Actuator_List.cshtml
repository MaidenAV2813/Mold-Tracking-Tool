@page
@model Tracking_Tool_System.Pages.Actuator.Actuator_ListModel
@{
	ViewData["Title"] = "Actuadores";
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Tipos de Actuadores</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                
                <div class="card-tools">
                    <a asp-page="/Actuator/CreateActuator" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Agregar nuevo tipo de Actuador
                    </a>

                    <a id="editBtn" class="btn btn-warning btn-sm disabled">
                        <i class="fas fa-edit"></i> Editar Actuador
                    </a>
                    @* <form method="post" asp-page-handler="Eliminar" id="deleteForm" style="display:inline;">
                        <input type="hidden" name="id" id="deleteId" />

                        <button id="deleteBtn" type="submit" class="btn btn-danger btn-sm disabled">
                            <i class="fas fa-trash"></i> Eliminar tipo de Actuador
                        </button>
                    </form> *@
                </div>
                <a asp-page="/Index"
                   class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Tipo de Actuador</th>
                            <th>Estado</th>
                            <th>Fecha de creación</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var Actuador in Model.GridList)
                        {
                            <tr onclick="selectRow(@Actuador.ActuatorID)" style="cursor:pointer;">
                                <td>@Actuador.ActuatorType</td>
                                <td>@(Actuador.ActuatorStatus ? "Activo" : "Inactivo")</td>
                                <td>@Actuador.DateCreation?.ToString("MM-dd-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>     
    </div>
</section>

<script>
    @* Remarca la linea seleccionada en la lista a modificar de actuadores*@
        function selectRow(id) {

            document.querySelectorAll("tbody tr").forEach(r => r.classList.remove("table-primary"));

            event.currentTarget.classList.add("table-primary");

            let editBtn = document.getElementById("editBtn");

            editBtn.classList.remove("disabled");
            editBtn.href = "/Actuator/EditActuator?id=" + id;
        }
</script>