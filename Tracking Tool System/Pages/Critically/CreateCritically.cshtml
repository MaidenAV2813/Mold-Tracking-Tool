@page
@model Tracking_Tool_System.Pages.Critically.CreateCriticallyModel
@{
	ViewData["Title"] = "Crear tipo de Criticidad";
}
<section class="content-header">
    <div class="container-fluid">
         <h1>Crear tipo de Criticidad</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Información de Criticidad</h3>
            </div>

            <form method="post">
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>Tipo de Criticidad</label>
                        <input asp-for="CriticallyType" class="form-control" placeholder="Ingrese el tipo de criticidad" />
                    </div>

                    <div class="form-group">
                        <label>Estado</label>
                        <select asp-for="CriticallyStatus" class="form-control">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-page="/Critically/Critically_List" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i>
                        Regresar
                    </a>
                </div>
            </form>
        </div>

    </div>
</section>