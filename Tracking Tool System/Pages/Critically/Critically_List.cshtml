@page
@model Tracking_Tool_System.Pages.Critically.Critically_ListModel
@{
	ViewData["Title"] = "Criticidad";
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Tipos de Criticidad</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                
                <div class="card-tools">
                    <a asp-page="/Critically/CreateCritically" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Agregar nuevo tipo de Criticidad
                    </a>
                    <form method="post" asp-page-handler="Eliminar" id="deleteForm" style="display:inline;">
                        <input type="hidden" name="id" id="deleteId" />

                        <button id="deleteBtn" type="submit" class="btn btn-danger btn-sm disabled">
                            <i class="fas fa-trash"></i> Eliminar tipo de Criticidad
                        </button>
                    </form>
                </div>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Tipo de Criticidad</th>
                            <th>Fecha de creación</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var Critically in Model.GridList)
                        {
                            <tr onclick="selectRow(@Critically.CriticallyID)" style="cursor:pointer;">
                                <td>@Critically.CriticallyType</td>
                                <td>@Critically.DateCreation?.ToString("MM-dd-yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>     
    </div>
</section>

<script>
    function selectRow(id) {

        document.querySelectorAll("tbody tr")
            .forEach(r => r.classList.remove("table-primary"));

        event.currentTarget.classList.add("table-primary");

        document.getElementById("deleteId").value = id;

        let deleteBtn = document.getElementById("deleteBtn");
        deleteBtn.classList.remove("disabled");
    }
</script>