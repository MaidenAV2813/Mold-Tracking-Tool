@page
@model Tracking_Tool_System.Pages.Gates.CreateGateModel
@{
	ViewData["Title"] = "Crear tipo de Gate";
}
<section class="content-header">
    <div class="container-fluid">
         <h1>Crear tipo de Gate</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Información del tipo de Gate</h3>
            </div>

            <form method="post">
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <label>Tipo de Gate</label>
                        <input asp-for="GateType" class="form-control" placeholder="Ingrese el tipo de Gate" />
                    </div>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                    <a asp-page="/Gates/Gate_List" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>

    </div>
</section>