@page
@model Tracking_Tool_System.Pages.Gates.EditModel

@{
    ViewData["Title"] = "Editar Gate";
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Modificar Gate</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Modificar</h3>
            </div>

            <form method="post">
                <div class="card-body">

                    <input type="hidden" asp-for="GateID" />

                    <div class="form-group">
                        <label>Tipo de Gate</label>
                        <input asp-for="GateType" class="form-control" disabled />
                        <input type="hidden" asp-for="GateType" />
                    </div>        

                    <div class="form-group">
                        <label>Estado</label>
                        <select asp-for="GateStatus" class="form-control">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Actualizar</button>
                    <a asp-page="/Gates/Gate_List" class="btn btn-secondary">
                        <i class="fas fa-arrow-left mr-1"></i>
                        Regresar
                    </a>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </form>

        </div>

    </div>
</section>
