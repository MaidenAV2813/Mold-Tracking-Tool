@page
@model Tracking_Tool_System.Pages.Evaluation.MoldEvaluation_ListModel

@{
    ViewData["Title"] = "Evaluaciones de moldes";
}

<section class="content-header">

    <div class="container-fluid">

        <h1>Evaluaciones de moldes</h1>

    </div>

</section>

<section class="content">

    <div class="container-fluid">

        <div class="card">

            <div class="card-header">

                <div class="card-tools">

                    <a asp-page="/MoldEvaluation/CreateMoldEvaluation"
                       class="btn btn-primary btn-sm">

                        <i class="fas fa-plus"></i>
                        Nueva evaluación

                    </a>

                </div>

                <a asp-page="/Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left mr-1"></i>
                    Regresar

                </a>

            </div>

            <div class="card-body">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="row mb-3">

                    <div class="col-md-4">

                        <label for="searchMold">
                            Buscar molde
                        </label>

                        <input type="text"
                               id="searchMold"
                               class="form-control"
                               placeholder="Digite el número de molde..."
                               autocomplete="off"
                               oninput="this.value = this.value.toUpperCase();" />

                    </div>

                </div>

                <div class="table-scroll-container">

                    <div class="horizontal-scroll">

                        <div class="horizontal-scroll-content">
                        </div>

                    </div>

                    <div class="table-responsive table-scroll">

                        <table class="table table-bordered table-striped table-sm2 text-nowrap">

                            <thead class="bg-primary text-white">

                                <tr>

                                    <th class="text-center"
                                        style="width:180px;">
                                        Número de molde
                                    </th>

                                    <th class="text-center">
                                        Porcentaje de la evaluación general
                                    </th>

                                    <th class="text-center">
                                        Fecha de evaluación
                                    </th>

                                    <th class="text-center">
                                        Próxima evaluación
                                    </th>

                                    <th class="text-center">
                                        Creado por
                                    </th>

                                </tr>

                            </thead>

                            <tbody id="evaluationTableBody">

                                @foreach (var item in Model.GridList)
                                {
                                    <tr class="evaluation-row"
                                        data-evaluation-id="@item.EvaluationID"
                                        style="cursor:pointer;">

                                        <td>
                                            @item.MoldNumber
                                        </td>

                                        <td class="text-center">

                                            @if (item.GeneralScore.HasValue)
                                            {
                                                if (item.GeneralScore >= 85)
                                                {
                                                    <span class="badge badge-success">

                                                        @($"{item.GeneralScore:N2}%")

                                                    </span>
                                                }
                                                else if (item.GeneralScore >= 70)
                                                {
                                                    <span class="badge badge-warning">

                                                        @($"{item.GeneralScore:N2}%")

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">

                                                        @($"{item.GeneralScore:N2}%")

                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">
                                                    N/A
                                                </span>
                                            }

                                        </td>

                                        <td class="text-center">

                                            @item.DateEvaluation?.ToString("MM-dd-yyyy")

                                        </td>

                                        <td class="text-center">

                                            @item.NextEvaluationDate?.ToString("MM-dd-yyyy")

                                        </td>

                                        <td>
                                            @item.CreatedBy
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {

    <script>
        $(function () {

            $('#searchMold').on('input', function () {

                const searchValue = $(this)
                    .val()
                    .trim()
                    .toLowerCase();

                $('#evaluationTableBody .evaluation-row')
                    .each(function () {

                        const moldNumber = $(this)
                            .find('td')
                            .eq(0)
                            .text()
                            .trim()
                            .toLowerCase();

                        $(this).toggle(
                            moldNumber.includes(searchValue)
                        );
                    });
            });

            $('.evaluation-row').on('click', function () {

                $('.evaluation-row')
                    .removeClass('table-primary');

                $(this)
                    .addClass('table-primary');

                const evaluationId =
                    $(this).data('evaluation-id');

                if (!evaluationId) {
                    return;
                }

                window.location.href =
                    '/MoldEvaluation/MoldEvaluation_Detail?id='
                    + evaluationId;
            });

        });
    </script>
}