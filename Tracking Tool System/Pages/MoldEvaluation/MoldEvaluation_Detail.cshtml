@page
@model Tracking_Tool_System.Pages.MoldEvaluation.MoldEvaluation_DetailModel

@{
    ViewData["Title"] = "Detalle de evaluación";
}

<section class="content-header">
    <div class="container-fluid">
        <h1>Detalle de evaluación de molde</h1>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <div class="card card-primary">

            <div class="card-header">
                <h3 class="card-title">
                    Información general
                </h3>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-3">
                        <strong>Molde</strong>
                        <p>@Model.Evaluation.MoldNumber</p>
                    </div>

                    <div class="col-md-3">
                        <strong>Fecha de evaluación</strong>
                        <p>
                            @Model.Evaluation.DateEvaluation?.ToString("MM-dd-yyyy")
                        </p>
                    </div>

                    <div class="col-md-3">
                        <strong>Próxima evaluación</strong>
                        <p>
                            @Model.Evaluation.NextEvaluationDate?.ToString("MM-dd-yyyy")
                        </p>
                    </div>

                    <div class="col-md-3">
                        <strong>Evaluación general</strong>

                        <p>
                            @if (Model.Evaluation.GeneralScore.HasValue)
                            {
                                if (Model.Evaluation.GeneralScore >= 90)
                                {
                                    <span class="badge badge-success">
                                        @($"{Model.Evaluation.GeneralScore:N2}%")
                                    </span>
                                }
                                else if (Model.Evaluation.GeneralScore >= 70)
                                {
                                    <span class="badge badge-warning">
                                        @($"{Model.Evaluation.GeneralScore:N2}%")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        @($"{Model.Evaluation.GeneralScore:N2}%")
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="badge badge-secondary">
                                    N/A
                                </span>
                            }
                        </p>
                    </div>

                </div>

                <hr />

                <h5>Partes evaluadas</h5>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead class="bg-primary text-white">
                            <tr>
                                <th>Parte</th>
                                <th class="text-center">
                                    Porcentaje
                                </th>
                                <th>Observación</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model.EvaluationParts)
                            {
                                <tr>

                                    <td>@item.Parts</td>

                                    <td class="text-center">

                                        @if (item.Score.HasValue)
                                        {
                                            if (item.Score >= 90)
                                            {
                                                <span class="badge badge-success">
                                                    @item.Score%
                                                </span>
                                            }
                                            else if (item.Score >= 70)
                                            {
                                                <span class="badge badge-warning">
                                                    @item.Score%
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">
                                                    @item.Score%
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">
                                                N/A
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            item.Observation)
                                            ? "Sin observación"
                                            : item.Observation)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <div class="card-footer">

                <a asp-page="/MoldEvaluation/MoldEvaluation_List"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Regresar
                </a>

            </div>

        </div>

    </div>
</section>