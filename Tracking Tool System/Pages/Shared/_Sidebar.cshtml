@{
    bool HasAccess(string accessName)
    {
        return User.Claims.Any(c =>
            c.Type == "Access" &&
            c.Value.Equals(accessName, StringComparison.OrdinalIgnoreCase));
    }
}

<!-- Main Sidebar Container -->
<aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <div class="brand-link">
        <img src="~/Template/dist/img/ICU-Medical-Logoz.png"
            alt="AdminLTE Logo"
            class="brand-image img-circle elevation-1"
            style="opacity: .8">
        <span class="brand-text font-weight-light">
            Tracking Tool System
        </span>
    </div>
 
    <!-- Sidebar -->
    <div class="sidebar">

        <div class="user-panel mt-3 pb-3 mb-3 d-flex">

            <div class="image">
                <img src="~/Template/dist/img/user.png" 
                    class="img-circle elevation-2" 
                    alt="User Image">
            </div>

            <div class="info">
                <a href="#" class="d-block">@(User.FindFirst("DisplayName")?.Value ?? 
                    User.Identity?.Name ?? "Username")</a>
            </div>

        </div>
 
        <!-- SidebarSearch Form -->
        <div class="form-inline">

            <div class="input-group" data-widget="sidebar-search">
                <input class="form-control form-control-sidebar" type="search" 
                    placeholder="Search" aria-label="Search">

                <div class="input-group-append">
                    <button class="btn btn-sidebar">
                        <i class="fas fa-search fa-fw"></i>
                    </button>
                </div>

            </div>

        </div>
 
        <!-- Sidebar Menu -->
        <nav class="mt-2">
            <ul class="nav nav-pills nav-sidebar flex-column" 
                data-widget="treeview" 
                role="menu" 
                data-accordion="false">
                     
                @if (HasAccess("Registro del Molde"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-clipboard-list"></i>
                            <p>
                                Registro del Molde
                            </p>
                            <i class="right fas fa-angle-left"></i>
                        </a>

                        <ul class="nav nav-treeview">

                            @if (HasAccess("Lista de moldes"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Mold/Mold_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                        <p>Lista de moldes</p>
                                    </a>
                                </li>
                            }         
                        
                        </ul>
                            
                    </li>

                }

                @if (HasAccess("Configuracion del Molde"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-cogs"></i>
                                <p> 
                                    Configuracion del Molde
                                </p>
                            <i class="right fas fa-angle-left"></i>
                        </a>

                        <ul class="nav nav-treeview">

                            @if (HasAccess("Tipos de Gates"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Gates/Gate_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                            <p>Tipos de Gates</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("Tipos de Coladas"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Casting/Casting_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                            <p>Tipos de Coladas</p>
                                    </a>
                                </li>

                            }
                                
                            @if (HasAccess("Tipos de Criticidad"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Critically/Critically_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                            <p>Tipos de Criticidad</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("Tipos de Actuadores"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Actuator/Actuator_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                            <p>Tipos de Actuadores</p>
                                    </a>
                                </li>
                            }
                               
                        </ul>
                            
                    </li>

                }

                @if (HasAccess("Evaluacion del Molde"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-clipboard-check"></i>
                                <p>
                                    Evaluacion del Molde
                                    @*<i class="fas fa-angle-left right"></i>*@
                                </p>
                        </a>
                            
                    </li>
                }

                @if (HasAccess("Mantenimiento del Molde"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-wrench"></i>
                                <p>
                                    Mantenimiento del Molde
                                    @*<i class="fas fa-angle-left right"></i>*@
                                </p>
                        </a>
                    </li>
                }

                @if (HasAccess("Inventario de Repuestos"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-boxes"></i>   
                                <p>
                                    Inventario de Repuestos
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                        </a>
                        <ul class="nav nav-treeview">

                            @if (HasAccess("Localidades"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Location/Location_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                        <p>Localidades</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("Tipos de Transacciones"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Transaction/Transaction_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                        <p>Tipos de Transacciones</p>
                                    </a>
                                </li>

                            }
                                
                            @if (HasAccess("Inventario"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/InventoryBOH/InventoryBOH_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                        <p>Inventario</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("Transacciones de Inventario"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/InventoryTransactions/InventoryTransactions_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                        <p>Transacciones de Inventario</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("BOM de Repuestos/Moldes"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/ItemBom/ItemBom_List" class="nav-link">
                                        <i class="fas fa-minus nav-icon"></i>
                                        <p>BOM de Repuestos/Moldes</p>
                                    </a>
                                </li>
                            }
                               
                        </ul>

                    </li>
                }

                @if (HasAccess("Reportes e Indicadores"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="nav-icon fas fa-chart-line"></i>
                                <p>
                                    Reportes e Indicadores
                                    @* <i class="fas fa-angle-left right"></i>*@
                                </p>
                        </a>
                    </li>
                }

                @if (HasAccess("Mantenimientos del sistema") || HasAccess("Roles") || HasAccess("Usuarios") || HasAccess("Accesos") || HasAccess("Reportes"))
                {
                    <li class="nav-item">
                        <a href="#" class="nav-link" role="button">
                            <i class="nav-icon fas fa-tools"></i>
                                <p>
                                    Mantenimientos del sistema
                                </p>
                            <i class="right fas fa-angle-left"></i>
                        </a>

                        <ul class="nav nav-treeview">
                            @if (HasAccess("Roles"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Rol/Rol_List" class="nav-link">
                                        <i class="fas fa-user-shield nav-icon"></i>
                                            <p>Roles</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("Usuarios"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/User/User_List" class="nav-link">
                                        <i class="fas fa-user nav-icon"></i>
                                            <p>Usuarios</p>
                                    </a>
                                </li>
                            }

                            @if (HasAccess("Accesos"))
                            {
                                <li class="nav-item">
                                    <a asp-page="/Access/Access_List" class="nav-link">
                                        <i class="fas fa-lock nav-icon"></i>
                                            <p>Accesos</p>
                                    </a>
                                </li>
                            }

                        </ul>
                    </li>
                }
            </ul>

        </nav>

    </div>

</aside>
 